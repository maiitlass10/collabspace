# انسخ هذا الملف إلى .env ثم عدّل القيم. لا تضع ملف .env في Git أبدًا.
DJANGO_DEBUG=True
# ولّد مفتاحًا جديدًا بالأمر الموجود في README
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite للتطوير المحلي (الافتراضي):
DATABASE_URL=sqlite:///db.sqlite3
# أو PostgreSQL:
# DATABASE_URL=postgres://collabspace:collabspace_dev_password@localhost:5432/collabspace

# عنوان الواجهة الأمامية (للتحقق من مصدر الطلبات CSRF)
FRONTEND_ORIGIN=http://localhost:5173

# Settings for `docker compose up` (copy this file to .env next to it).
# Never commit the real .env file.

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me-too

# The address people open in the browser.
SITE_URL=http://localhost:8080
HTTP_PORT=8080
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# On a real server behind HTTPS, set both to True.
DJANGO_SECURE_COOKIES=False
DJANGO_BEHIND_HTTPS_PROXY=False
